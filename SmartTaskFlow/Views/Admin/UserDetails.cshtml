@model SmartTaskFlow.Models.User

@{
    var completedTasks = Model.Tasks.Where(t => t.Status == "Completed").Count();
    var pendingTasks = Model.Tasks.Where(t => t.Status == "ToDo").Count();
    var inProgressTasks = Model.Tasks.Where(t => t.Status == "InProgress").Count();
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
            <i class="bi bi-person-circle"></i> Détails de l'utilisateur
        </h2>
        <a asp-action="Users" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Retour à la liste
        </a>
    </div>

    <!-- Informations de l'utilisateur -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-info-circle"></i> Informations</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <strong>Nom d'utilisateur :</strong>
                        <p>@Model.Username</p>
                    </div>
                    <div class="mb-3">
                        <strong>Nom complet :</strong>
                        <p>@Model.FullName</p>
                    </div>
                    <div class="mb-3">
                        <strong>Email :</strong>
                        <p>@Model.Email</p>
                    </div>
                    <div class="mb-3">
                        <strong>Rôle :</strong>
                        <p>
                            @if (Model.Role == "Admin")
                            {
                                <span class="badge bg-danger">
                                    <i class="bi bi-shield-fill"></i> Administrateur
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    <i class="bi bi-person"></i> Utilisateur
                                </span>
                            }
                        </p>
                    </div>
                    <div class="mb-3">
                        <strong>Statut :</strong>
                        <p>
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success">
                                    <i class="bi bi-check-circle"></i> Actif
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning">
                                    <i class="bi bi-x-circle"></i> Inactif
                                </span>
                            }
                        </p>
                    </div>
                    <div class="mb-3">
                        <strong>Inscrit le :</strong>
                        <p>@Model.CreatedAt.ToString("dd/MM/yyyy à HH:mm")</p>
                    </div>
                    <div class="mb-0">
                        <strong>Dernière connexion :</strong>
                        <p>
                            @if (Model.LastLogin.HasValue)
                            {
                                @Model.LastLogin.Value.ToString("dd/MM/yyyy à HH:mm")
                            }
                            else
                            {
                                <em class="text-muted">Jamais connecté</em>
                            }
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <!-- Statistiques -->
            <div class="card mb-3">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-graph-up"></i> Statistiques</h5>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-md-3">
                            <div class="p-3 border rounded">
                                <h3 class="text-primary">@Model.Tasks.Count</h3>
                                <small class="text-muted">Total tâches</small>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="p-3 border rounded">
                                <h3 class="text-success">@completedTasks</h3>
                                <small class="text-muted">Complétées</small>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="p-3 border rounded">
                                <h3 class="text-warning">@inProgressTasks</h3>
                                <small class="text-muted">En cours</small>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="p-3 border rounded">
                                <h3 class="text-info">@pendingTasks</h3>
                                <small class="text-muted">À faire</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tâches de l'utilisateur -->
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="bi bi-list-task"></i> Tâches (@Model.Tasks.Count)</h5>
                </div>
                <div class="card-body">
                    @if (Model.Tasks.Any())
                    {
                        <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                            <table class="table table-sm table-hover">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th>Titre</th>
                                        <th>Catégorie</th>
                                        <th>Priorité</th>
                                        <th>Statut</th>
                                        <th>Deadline</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var task in Model.Tasks.OrderByDescending(t => t.CreatedAt))
                                    {
                                        <tr>
                                            <td>
                                                <strong>@task.Title</strong>
                                            </td>
                                            <td>
                                                @if (task.Category != null)
                                                {
                                                    <span class="badge" style="background-color: @task.Category.ColorCode">
                                                        @task.Category.Icon @task.Category.CategoryName
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                @for (int i = 0; i < task.Priority; i++)
                                                {
                                                    <i class="bi bi-star-fill text-warning"></i>
                                                }
                                            </td>
                                            <td>
                                                @if (task.Status == "Completed")
                                                {
                                                    <span class="badge bg-success">Complétée</span>
                                                }
                                                else if (task.Status == "InProgress")
                                                {
                                                    <span class="badge bg-warning">En cours</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">À faire</span>
                                                }
                                            </td>
                                            <td>
                                                @if (task.Deadline.HasValue)
                                                {
                                                    <small>@task.Deadline.Value.ToString("dd/MM/yyyy")</small>
                                                    @if (task.IsOverdue)
                                                    {
                                                        <br />
                                        
                                                        <span class="badge bg-danger">En retard</span>
                                                    }
                                                }
                                                else
                                                {
                                                    <em class="text-muted">Aucune</em>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mb-0">
                            <i class="bi bi-info-circle"></i> Aucune tâche créée.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Journal d'activité -->
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0"><i class="bi bi-clock-history"></i> Journal d'activité (Dernières 20 actions)</h5>
                </div>
                <div class="card-body">
                    @if (Model.ActivityLogs.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Date</th>
                                        <th>Action</th>
                                        <th>Tâche</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var log in Model.ActivityLogs.OrderByDescending(l => l.ActionDate).Take(20))
                                    {
                                        <tr>
                                            <td>
                                                <small>@log.ActionDate.ToString("dd/MM/yyyy HH:mm")</small>
                                            </td>
                                            <td>
                                                @if (log.Action == "Created")
                                                {
                                                    <span class="badge bg-success">Créée</span>
                                                }
                                                else if (log.Action == "Completed")
                                                {
                                                    <span class="badge bg-primary">Complétée</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">@log.Action</span>
                                                }
                                            </td>
                                            <td>
                                                @if (log.Task != null)
                                                {
                                                    <text>@log.Task.Title</text>
                                                }
                                                else
                                                {
                                                    <em class="text-muted">Tâche supprimée</em>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mb-0">
                            <i class="bi bi-info-circle"></i> Aucune activité enregistrée.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>