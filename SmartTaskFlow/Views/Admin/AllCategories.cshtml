 @model IEnumerable<SmartTaskFlow.Models.Category>


<div class="container mt-4">
    <h1>🏷️ Toutes les catégories</h1>
    <p class="text-muted">Catégories de tous les utilisateurs</p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">✅ @TempData["SuccessMessage"]</div>
    }

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Catégorie</th>
                            <th>Propriétaire</th>
                            <th>Nombre de tâches</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var category in Model)
                        {
                            var taskCount = ViewBag.TaskCounts[category.CategoryId];
                            var userName = ViewBag.UserNames[category.CategoryId];

                            <tr>
                                <td>
                                    <span class="badge" style="background-color: @category.ColorCode;">
                                        @category.Icon @category.CategoryName
                                    </span>
                                </td>
                                <td>
                                    <i class="bi bi-person-circle"></i> @userName
                                </td>
                                <td>
                                    <span class="badge bg-info">@taskCount tâche(s)</span>
                                </td>
                                <td>
                                    <a asp-controller="Category" asp-action="Details" asp-route-id="@category.CategoryId"
                                       class="btn btn-sm btn-info">
                                        <i class="bi bi-eye"></i> Voir
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Retour au dashboard
        </a>
    </div>
</div>