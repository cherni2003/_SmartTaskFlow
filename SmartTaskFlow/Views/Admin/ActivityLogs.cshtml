@model IEnumerable<SmartTaskFlow.Models.UserActivityLog>



<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
            <i class="bi bi-journal-text"></i> Journal d'Activité
        </h2>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Retour au tableau de bord
        </a>
    </div>

    <!-- Filtres -->
    <div class="card mb-4">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0"><i class="bi bi-funnel"></i> Filtres</h5>
        </div>
        <div class="card-body">
            <form method="get" asp-action="ActivityLogs">
                <div class="row">
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label">Utilisateur</label>
                            <select name="userId" class="form-select">
                                <option value="">Tous les utilisateurs</option>
                                @foreach (var user in ViewBag.Users)
                                {
                                    var isSelected = (ViewBag.SelectedUserId == user.UserId);
                                    <option value="@user.UserId" selected="@(isSelected ? "selected" : null)">
                                        @user.FullName (@user.Username)
                                    </option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="mb-3">
                            <label class="form-label">Date de début</label>
                            <input type="date" 
                                   name="startDate" 
                                   class="form-control"
                                   value="@(ViewBag.StartDate?.ToString("yyyy-MM-dd"))" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="mb-3">
                            <label class="form-label">Date de fin</label>
                            <input type="date" 
                                   name="endDate" 
                                   class="form-control"
                                   value="@(ViewBag.EndDate?.ToString("yyyy-MM-dd"))" />
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="mb-3">
                            <label class="form-label">&nbsp;</label>
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="bi bi-search"></i> Filtrer
                            </button>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <a asp-action="ActivityLogs" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-x-circle"></i> Réinitialiser les filtres
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Résumé -->
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> 
        Affichage de <strong>@Model.Count()</strong> entrées 
        @if (ViewBag.SelectedUserId != null && ViewBag.SelectedUserId > 0)
        {
            var users = (IEnumerable<SmartTaskFlow.Models.User>)ViewBag.Users;
            var selectedUser = users.FirstOrDefault(u => u.UserId == ViewBag.SelectedUserId);
            if (selectedUser != null)
            {
                <text> pour <strong>@selectedUser.FullName</strong></text>
            }
        }
        @if (ViewBag.StartDate != null || ViewBag.EndDate != null)
        {
            <text> du </text>
            if (ViewBag.StartDate != null)
            {
                <strong>@ViewBag.StartDate?.ToString("dd/MM/yyyy")</strong>
            }
            else
            {
                <text>début</text>
            }
            <text> au </text>
            if (ViewBag.EndDate != null)
            {
                <strong>@ViewBag.EndDate?.ToString("dd/MM/yyyy")</strong>
            }
            else
            {
                <text>aujourd'hui</text>
            }
        }
        (Limité à 100 entrées les plus récentes)
    </div>

    <!-- Journal d'activité -->
    <div class="card">
        <div class="card-header bg-secondary text-white">
            <h5 class="mb-0"><i class="bi bi-clock-history"></i> Activités Enregistrées</h5>
        </div>
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 150px;">Date & Heure</th>
                                <th>Utilisateur</th>
                                <th style="width: 120px;">Action</th>
                                <th>Tâche</th>
                                <th>Détails</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@log.ActionDate.ToString("dd/MM/yyyy")</strong>
                                        <br />
                                        <small class="text-muted">@log.ActionDate.ToString("HH:mm:ss")</small>
                                    </td>
                                    <td>
                                        <strong>@log.User.FullName</strong>
                                        <br />
                                        <small class="text-muted">
                                            @log.User.Username
                                            @if (log.User.Role == "Admin")
                                            {
                                                <span class="badge bg-danger">Admin</span>
                                            }
                                        </small>
                                    </td>
                                    <td>
                                        @if (log.Action == "Created")
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-plus-circle"></i> Créée
                                            </span>
                                        }
                                        else if (log.Action == "Completed")
                                        {
                                            <span class="badge bg-primary">
                                                <i class="bi bi-check-circle"></i> Complétée
                                            </span>
                                        }
                                        else if (log.Action == "Updated")
                                        {
                                            <span class="badge bg-warning">
                                                <i class="bi bi-pencil"></i> Modifiée
                                            </span>
                                        }
                                        else if (log.Action == "Deleted")
                                        {
                                            <span class="badge bg-danger">
                                                <i class="bi bi-trash"></i> Supprimée
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@log.Action</span>
                                        }
                                    </td>
                                    <td>
                                        @if (log.Task != null)
                                        {
                                            <strong>@log.Task.Title</strong>
                                            @if (log.Task.Category != null)
                                            {
                                                <br />
                                                <small>
                                                    <span class="badge" style="background-color: @log.Task.Category.ColorCode">
                                                        @log.Task.Category.Icon @log.Task.Category.CategoryName
                                                    </span>
                                                </small>
                                            }
                                        }
                                        else
                                        {
                                            <em class="text-muted">Tâche supprimée</em>
                                        }
                                    </td>
                                    <td>
                                        @if (log.Task != null)
                                        {
                                            <small>
                                                Priorité : 
                                                @for (int i = 0; i < log.Task.Priority; i++)
                                                {
                                                    <i class="bi bi-star-fill text-warning"></i>
                                                }
                                                <br />
                                                Statut : 
                                                @if (log.Task.Status == "Completed")
                                                {
                                                    <span class="badge bg-success">Complétée</span>
                                                }
                                                else if (log.Task.Status == "InProgress")
                                                {
                                                    <span class="badge bg-warning">En cours</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">À faire</span>
                                                }
                                            </small>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info mb-0">
                    <i class="bi bi-info-circle"></i> 
                    Aucune activité trouvée avec ces filtres.
                </div>
            }
        </div>
    </div>
</div>