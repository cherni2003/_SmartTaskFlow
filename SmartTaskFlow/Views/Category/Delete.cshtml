@model SmartTaskFlow.Models.Category

@{
    ViewData["Subtitle"] = "Confirmation de suppression";
    var completedTasks = Model.Tasks.Count(t => t.Status == "Completed");
    var inProgressTasks = Model.Tasks.Count(t => t.Status == "InProgress");
    var todoTasks = Model.Tasks.Count(t => t.Status == "ToDo");
}

<div class="container py-4 py-lg-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <!-- En-tête -->
            <div class="mb-5 animate-slide-up">
                <div class="badge bg-gradient-danger bg-opacity-10 text-danger rounded-pill px-4 py-2 mb-3 d-inline-flex align-items-center">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <span class="fw-semibold">Action critique</span>
                </div>
                <h1 class="display-5 fw-bold mb-2">🗑️ Supprimer la catégorie</h1>
                <p class="text-muted mb-0">Cette action est irréversible</p>
            </div>

            <!-- Carte d'avertissement -->
            <div class="card border-danger border-3 rounded-4 shadow-lg mb-5 animate-slide-up" style="animation-delay: 0.1s">
                <div class="card-header bg-gradient-danger text-white border-0 py-4 px-5">
                    <div class="d-flex align-items-center">
                        <div class="warning-icon bg-white bg-opacity-20 rounded-circle d-inline-flex align-items-center justify-content-center p-3 me-3">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                        </div>
                        <div>
                            <h5 class="mb-0 fw-bold">⚠️ Action critique requise</h5>
                            <small class="opacity-75">Confirmez-vous cette suppression ?</small>
                        </div>
                    </div>
                </div>
                <div class="card-body p-5">
                    <div class="alert alert-warning border-warning bg-warning bg-opacity-10 border-2 d-flex align-items-start mb-4">
                        <div class="alert-icon me-3">
                            <i class="bi bi-exclamation-octagon-fill text-warning fs-4"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-2">Attention ! Cette action est permanente</h6>
                            @if (Model.Tasks.Any())
                            {
                                <p class="mb-2">
                                    <span class="text-danger fw-bold">Cette catégorie contient @Model.Tasks.Count tâche(s).</span>
                                    Les tâches ne seront pas supprimées mais n'auront plus de catégorie associée.
                                </p>
                            }
                            <p class="mb-0">Il n'y aura pas de possibilité de récupération après confirmation.</p>
                        </div>
                    </div>

                    <!-- Aperçu de la catégorie -->
                    <div class="category-preview-wrapper mb-5">
                        <h6 class="fw-bold mb-3 text-muted">Catégorie à supprimer :</h6>
                        <div class="card border-0 shadow-sm overflow-hidden rounded-4">
                            <div class="card-body p-5 text-center"
                                 style="background: linear-gradient(135deg, @(Model.ColorCode ?? "#4361ee") 0%, @(DarkenColor(Model.ColorCode ?? "#4361ee", 20)) 100%);">
                                <div class="category-icon-large mb-4">
                                    <span>@(Model.Icon ?? "📁")</span>
                                </div>
                                <h2 class="text-white fw-bold mb-3">@Model.CategoryName</h2>
                                <div class="d-flex justify-content-center gap-3">
                                    <span class="badge bg-white bg-opacity-20 text-white py-2 px-4">
                                        <i class="bi bi-list-task me-2"></i>@Model.Tasks.Count tâche@(Model.Tasks.Count > 1 ? "s" : "")
                                    </span>
                                    <span class="badge bg-white bg-opacity-20 text-white py-2 px-4">
                                        <i class="bi bi-hash me-2"></i>ID: @Model.CategoryId
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Informations détaillées -->
                    <div class="row g-4 mb-5">
                        <div class="col-md-6">
                            <div class="card border-0 shadow-sm h-100 rounded-4">
                                <div class="card-header bg-light border-0 py-3 px-4">
                                    <h6 class="mb-0 fw-semibold d-flex align-items-center">
                                        <i class="bi bi-info-circle me-2 text-primary"></i>
                                        Informations générales
                                    </h6>
                                </div>
                                <div class="card-body p-4">
                                    <dl class="row mb-0">
                                        <dt class="col-sm-5 text-muted">Nom :</dt>
                                        <dd class="col-sm-7 fw-semibold">@Model.CategoryName</dd>

                                        <dt class="col-sm-5 text-muted">Icône :</dt>
                                        <dd class="col-sm-7 fw-semibold">@(Model.Icon ?? "Non définie")</dd>

                                        <dt class="col-sm-5 text-muted">Couleur :</dt>
                                        <dd class="col-sm-7">
                                            <div class="d-flex align-items-center">
                                                <div class="color-dot me-2" style="background-color: @(Model.ColorCode ?? "#4361ee")"></div>
                                                <span class="fw-semibold">@(Model.ColorCode ?? "Par défaut")</span>
                                            </div>
                                        </dd>

                                        <dt class="col-sm-5 text-muted">Identifiant :</dt>
                                        <dd class="col-sm-7 fw-semibold">#@Model.CategoryId</dd>
                                    </dl>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card border-0 shadow-sm h-100 rounded-4">
                                <div class="card-header bg-light border-0 py-3 px-4">
                                    <h6 class="mb-0 fw-semibold d-flex align-items-center">
                                        <i class="bi bi-bar-chart me-2 text-success"></i>
                                        Statistiques des tâches
                                    </h6>
                                </div>
                                <div class="card-body p-4">
                                    <dl class="row mb-0">
                                        <dt class="col-sm-6 text-muted">Total des tâches :</dt>
                                        <dd class="col-sm-6 fw-semibold">@Model.Tasks.Count</dd>

                                        <dt class="col-sm-6 text-muted">Tâches complétées :</dt>
                                        <dd class="col-sm-6 fw-semibold">
                                            <span class="text-success">@completedTasks</span>
                                        </dd>

                                        <dt class="col-sm-6 text-muted">Tâches en cours :</dt>
                                        <dd class="col-sm-6 fw-semibold">
                                            <span class="text-primary">@inProgressTasks</span>
                                        </dd>

                                        <dt class="col-sm-6 text-muted">Tâches à faire :</dt>
                                        <dd class="col-sm-6 fw-semibold">
                                            <span class="text-warning">@todoTasks</span>
                                        </dd>
                                    </dl>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tâches associées -->
                    @if (Model.Tasks.Any())
                    {
                        <div class="card border-warning border-2 shadow-sm rounded-4 mb-5">
                            <div class="card-header bg-warning bg-opacity-10 border-0 py-4 px-4">
                                <div class="d-flex align-items-center">
                                    <div class="task-icon bg-warning bg-opacity-25 rounded-circle p-3 me-3">
                                        <i class="bi bi-exclamation-triangle text-warning"></i>
                                    </div>
                                    <div>
                                        <h6 class="mb-0 fw-bold">📋 Tâches affectées</h6>
                                        <small class="text-muted">Ces tâches perdront leur catégorie</small>
                                    </div>
                                </div>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover mb-0">
                                        <thead class="bg-light">
                                            <tr>
                                                <th class="border-0 ps-4">Tâche</th>
                                                <th class="border-0">Statut</th>
                                                <th class="border-0">Priorité</th>
                                                <th class="border-0 pe-4">Échéance</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var task in Model.Tasks.Take(8))
                                            {
                                                <tr class="transition-all">
                                                    <td class="ps-4">
                                                        <div class="d-flex align-items-center">
                                                            <div class="task-check me-3">
                                                                <div class="form-check">
                                                                    <input class="form-check-input" type="checkbox"
                                                                           @(task.Status == "Completed" ? "checked" : "") disabled>
                                                                </div>
                                                            </div>
                                                            <div>
                                                                <h6 class="mb-0 fw-semibold @(task.Status == "Completed" ? "text-muted text-decoration-line-through" : "")">
                                                                    @task.Title
                                                                </h6>
                                                                <small class="text-muted">@(task.Description?.Length > 50 ? task.Description.Substring(0, 50) + "..." : task.Description)</small>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <span class="badge @(task.Status == "Completed" ? "bg-success bg-opacity-10 text-success border border-success border-opacity-25" :
                                                                                                                                       task.Status == "InProgress" ? "bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25" :
                                                                                                                                       "bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25")">
                                                            @task.StatusFrench
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25">
                                                            @task.PriorityBadge
                                                        </span>
                                                    </td>
                                                    <td class="pe-4">
                                                        @if (task.Deadline.HasValue)
                                                        {
                                                            <span class="@(task.IsOverdue ? "text-danger fw-bold" : "text-muted")">
                                                                <i class="bi bi-calendar me-1"></i>
                                                                @task.Deadline.Value.ToString("dd/MM/yyyy")
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">-</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                            @if (Model.Tasks.Count > 8)
                                            {
                                                <tr>
                                                    <td colspan="4" class="text-center text-muted py-3">
                                                        Et @(Model.Tasks.Count - 8) autre(s) tâche(s)...
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Formulaire de suppression -->
                    <form asp-action="Delete" method="post" id="deleteForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="CategoryId" />

                        <div class="card border-0 shadow-sm rounded-4">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="fw-bold mb-2">Confirmez la suppression</h6>
                                        <p class="text-muted mb-0">Cette action ne peut pas être annulée</p>
                                    </div>
                                    <div class="d-flex gap-3">
                                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-5 py-3">
                                            <i class="bi bi-x-circle me-2"></i>
                                            Annuler
                                        </a>
                                        <button type="submit" class="btn btn-danger btn-lg px-5 py-3 shadow-sm-hover"
                                                onclick="return confirmDelete()">
                                            <i class="bi bi-trash me-2"></i>
                                            Oui, supprimer définitivement
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    // Fonction helper pour assombrir les couleurs côté serveur
    private string DarkenColor(string color, int percent)
    {
        if (string.IsNullOrEmpty(color) || !color.StartsWith("#") || color.Length != 7)
            return color;

        try
        {
            var r = Convert.ToInt32(color.Substring(1, 2), 16);
            var g = Convert.ToInt32(color.Substring(3, 2), 16);
            var b = Convert.ToInt32(color.Substring(5, 2), 16);

            r = (int)(r * (100 - percent) / 100.0);
            g = (int)(g * (100 - percent) / 100.0);
            b = (int)(b * (100 - percent) / 100.0);

            return $"#{r:X2}{g:X2}{b:X2}";
        }
        catch
        {
            return color;
        }
    }
}

<style>
    /* Styles spécifiques à la suppression */
    .warning-icon {
        width: 56px;
        height: 56px;
    }

    .category-preview-wrapper {
        position: relative;
    }

    .category-icon-large {
        width: 80px;
        height: 80px;
        background-color: rgba(255, 255, 255, 0.2);
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
        font-size: 2.5rem;
        backdrop-filter: blur(10px);
    }

    .color-dot {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        border: 2px solid white;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    }

    .task-icon {
        width: 56px;
        height: 56px;
    }

    .task-check .form-check-input {
        width: 1em;
        height: 1em;
        cursor: default;
    }

        .task-check .form-check-input:checked {
            background-color: #198754;
            border-color: #198754;
        }

    .table th {
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 0.5px;
    }

    .table tbody tr {
        border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        transition: all 0.3s ease;
    }

        .table tbody tr:hover {
            background-color: rgba(255, 193, 7, 0.05);
        }

    .alert-icon {
        min-width: 24px;
    }

    /* Animation de pulsation pour l'alerte */
    .alert-warning {
        animation: pulseWarning 2s infinite;
    }

    .btn-danger {
        position: relative;
        overflow: hidden;
    }

        .btn-danger::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 50%;
            transform: translate(-50%, -50%);
            transition: width 0.6s, height 0.6s;
        }

        .btn-danger:active::after {
            width: 300px;
            height: 300px;
        }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Animation des lignes du tableau
        const tableRows = document.querySelectorAll('.table tbody tr');
        tableRows.forEach((row, index) => {
            row.style.opacity = '0';
            row.style.transform = 'translateX(-10px)';

            setTimeout(() => {
                row.style.transition = 'all 0.5s ease';
                row.style.opacity = '1';
                row.style.transform = 'translateX(0)';
            }, index * 100 + 300);
        });

        // Animation de l'icône de catégorie
        const categoryIcon = document.querySelector('.category-icon-large');
        if (categoryIcon) {
            categoryIcon.style.transform = 'scale(0) rotate(-180deg)';

            setTimeout(() => {
                categoryIcon.style.transition = 'all 0.8s cubic-bezier(0.34, 1.56, 0.64, 1)';
                categoryIcon.style.transform = 'scale(1) rotate(0deg)';
            }, 500);
        }

        // Animation des badges
        const badges = document.querySelectorAll('.badge');
        badges.forEach((badge, index) => {
            badge.style.opacity = '0';
            badge.style.transform = 'translateY(10px)';

            setTimeout(() => {
                badge.style.transition = 'all 0.4s ease';
                badge.style.opacity = '1';
                badge.style.transform = 'translateY(0)';
            }, index * 50 + 400);
        });
    });

    // Confirmation de suppression
    function confirmDelete() {
        const categoryName = "@Model.CategoryName";
        const taskCount = @Model.Tasks.Count;

        let message = `⚠️ Confirmer la suppression de la catégorie "${categoryName}" ?`;

        if (taskCount > 0) {
            message += `\n\nCette catégorie contient ${taskCount} tâche(s) qui perdront leur catégorie.`;
        }

        message += "\n\nCette action est irréversible !";

        return confirm(message);
    }

    // Animation de pulsation
    @@keyframes pulseWarning {
        0% {
            box-shadow: 0 0 0 0 rgba(255, 193, 7, 0.4);
        }
        70% {
            box-shadow: 0 0 0 10px rgba(255, 193, 7, 0);
        }
        100% {
            box-shadow: 0 0 0 0 rgba(255, 193, 7, 0);
        }
    }
</script>