                    <!-- Floating Elements -->
                    <div class="floating-element floating-1 bg-gradient-warning rounded-circle position-absolute"></div>
                    <div class="floating-element floating-2 bg-gradient-primary rounded-circle position-absolute"></div>
                    <div class="floating-element floating-3 bg-gradient-info rounded-circle position-absolute"></div>
                </div>
