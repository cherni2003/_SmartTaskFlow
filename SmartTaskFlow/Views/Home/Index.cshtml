@{
    ViewData["Title"] = "SmartTaskFlow - Gestion Intelligente des Tâches";
    ViewData["Subtitle"] = "Organisez vos tâches selon votre énergie, votre temps et vos priorités réelles";
}

<!-- Hero Section -->
<section class="hero-section py-5 py-lg-6 position-relative overflow-hidden">
    <div class="container position-relative z-2">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <div class="hero-content pe-lg-4">
                    <div class="badge bg-gradient-primary bg-opacity-10 text-primary rounded-pill px-4 py-2 mb-4 d-inline-flex align-items-center animate-fade-in">
                        <i class="bi bi-stars me-2"></i>
                        <span class="fw-semibold">Révolutionnez votre productivité</span>
                    </div>

                    <h1 class="display-4 fw-bold mb-4 animate-slide-up">
                        Gestion <span class="text-gradient-primary">intelligente</span> de vos tâches quotidiennes
                    </h1>

                    <p class="lead text-muted mb-5 animate-slide-up" style="animation-delay: 0.1s;">
                        SmartTaskFlow analyse votre énergie, votre temps disponible et vos priorités pour vous suggérer la meilleure tâche à accomplir en ce moment.
                    </p>

                    <div class="d-flex flex-wrap gap-3 animate-slide-up" style="animation-delay: 0.2s;">
                        <a asp-controller="Account" asp-action="Signup" class="btn btn-primary btn-lg px-4 px-md-5 py-3 shadow-sm-hover">
                            <i class="bi bi-rocket-takeoff me-2"></i>Commencer gratuitement
                        </a>
                        <a asp-controller="Task" asp-action="SmartSuggestion" class="btn btn-outline-primary btn-lg px-4 px-md-5 py-3">
                            <i class="bi bi-robot me-2"></i>Essayer le mode intelligent
                        </a>
                    </div>

                    <!-- Trust Indicators -->
                    <div class="mt-5 pt-3 animate-fade-in" style="animation-delay: 0.3s;">
                        <p class="text-muted small mb-3">Rejoignez notre communauté de productivité</p>
                        <div class="d-flex align-items-center">
                            <div class="avatar-group me-3">
                                <div class="avatar avatar-sm" style="background-image: url('https://api.dicebear.com/7.x/avataaars/svg?seed=1')"></div>
                                <div class="avatar avatar-sm" style="background-image: url('https://api.dicebear.com/7.x/avataaars/svg?seed=2')"></div>
                                <div class="avatar avatar-sm" style="background-image: url('https://api.dicebear.com/7.x/avataaars/svg?seed=3')"></div>
                                <div class="avatar avatar-sm" style="background-image: url('https://api.dicebear.com/7.x/avataaars/svg?seed=4')"></div>
                            </div>
                            <div>
                                <p class="mb-0 fw-semibold">10,000+ utilisateurs</p>
                                <p class="text-muted small mb-0">Augmentent leur productivité</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
